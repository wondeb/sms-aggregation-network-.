import React, { useState, useEffect } from 'react';
import { 
  View, Text, StyleSheet, Alert, ScrollView, TextInput, 
  TouchableOpacity, Share 
} from 'react-native';
import AsyncStorage from '@react-native-async-storage/async-storage';
import axios from 'axios';
import { API_URL, ENDPOINTS } from '../config';
import { useAuth } from '../context/AuthContext';

const ReferralScreen = () => {
  const [referralLink, setReferralLink] = useState('');
  const [stats, setStats] = useState({ total_referrals: 0, total_commission: 0 });
  const [loading, setLoading] = useState(false);
  const { user } = useAuth();

  useEffect(() => {
    generateLink();
  }, []);

  const generateLink = async () => {
    setLoading(true);
    try {
      const token = await AsyncStorage.getItem('token');
      const res = await axios.get(`${API_URL}${ENDPOINTS.REFERRAL_LINK}`, {
        headers: { Authorization: `Bearer ${token}` }
      });
      setReferralLink(res.data.link);
      setStats({
        total_referrals: res.data.total_referrals,
        total_commission: res.data.total_commission
      });
    } catch (error) {
      Alert.alert('Error', 'Failed to generate referral link');
    } finally {
      setLoading(false);
    }
  };

  const shareLink = async () => {
    try {
      await Share.share({
        message: `Join SMS Network and start earning! Use my referral link: ${referralLink}`,
        title: 'SMS Network Referral'
      });
    } catch (error) {
      Alert.alert('Error', 'Failed to share link');
    }
  };

  const copyLink = () => {
    Alert.alert('Copied!', 'Link copied to clipboard. Share with friends!');
  };

  return (
    <ScrollView style={styles.container}>
      <View style={styles.header}>
        <Text style={styles.title}>🚀 Become a Partner</Text>
        <Text style={styles.subtitle}>Earn 5% commission on your friends' earnings forever!</Text>
      </View>

      <View style={styles.statsCard}>
        <View style={styles.statItem}>
          <Text style={styles.statValue}>{stats.total_referrals}</Text>
          <Text style={styles.statLabel}>Referrals</Text>
        </View>
        <View style={styles.statDivider} />
        <View style={styles.statItem}>
          <Text style={styles.statValue}>${stats.total_commission.toFixed(2)}</Text>
          <Text style={styles.statLabel}>Earned</Text>
        </View>
      </View>

      <View style={styles.linkSection}>
        <Text style={styles.linkLabel}>Your Referral Link</Text>
        <TextInput
          style={styles.linkInput}
          value={referralLink}
          editable={false}
          selectTextOnFocus
          multiline
        />
        
        <View style={styles.buttonRow}>
          <TouchableOpacity style={styles.copyBtn} onPress={copyLink}>
            <Text style={styles.copyText}>📋 Copy Link</Text>
          </TouchableOpacity>
          
          <TouchableOpacity style={styles.shareBtn} onPress={shareLink}>
            <Text style={styles.shareText}>📤 Share</Text>
          </TouchableOpacity>
        </View>
      </View>

      <View style={styles.infoCard}>
        <Text style={styles.infoTitle}>How It Works</Text>
        <Text style={styles.infoStep}>1. Share your unique referral link with friends</Text>
        <Text style={styles.infoStep}>2. They sign up and start earning</Text>
        <Text style={styles.infoStep}>3. You earn 5% of their earnings automatically</Text>
        <Text style={styles.infoStep}>4. No limit on how much you can earn!</Text>
      </View>

      <View style={styles.tipsCard}>
        <Text style={styles.tipsTitle}>💡 Pro Tips</Text>
        <Text style={styles.tipsText}>• Share on social media and forums</Text>
        <Text style={styles.tipsText}>• Create content about earning online</Text>
        <Text style={styles.tipsText}>• Target people looking for side income</Text>
      </View>
    </ScrollView>
  );
};

