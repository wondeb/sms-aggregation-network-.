@echo off
echo ==================================
echo SMS Aggregation Network - Setup
echo ==================================

docker --version >nul 2>&1
if errorlevel 1 (
    echo [ERROR] Docker not found. Install Docker Desktop first.
    pause
    exit /b 1
)

if not exist .env (
    echo [WARN] Creating .env template - EDIT IT!
    echo DB_PASSWORD=ChangeMe_DB_2024!> .env
    echo REDIS_PASSWORD=ChangeMe_Redis_2024!>> .env
    echo ADMIN_PASSWORD=ChangeMe_Admin_2024!>> .env
    echo FIVESIM_API_KEY=your_fivesim_key_here>> .env
    echo HEROSMS_API_KEY=your_herosms_key_here>> .env
)

echo Building containers...
docker-compose build

echo Starting database...
docker-compose up -d postgres redis
timeout /t 10 /nobreak >nul

echo Running migrations...
docker-compose exec -T postgres psql -U sms_admin -d sms_network ^
    < migrations\001_initial_schema.sql

echo Starting services...
docker-compose up -d

echo.
echo Deployment complete!
echo   Master API:   http://localhost:3000
echo   Admin Panel:  http://localhost:8080
pause
